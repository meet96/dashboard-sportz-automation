# Shared MongoDB — same cluster/DB as dashboard-sportz
MONGODB_URI=

# Cricbuzz (RapidAPI) — same values as the main app's .env
CRICBUZZ_API_KEY=
CRICBUZZ_API_HOST=cricbuzz-cricket.p.rapidapi.com

# Per-caller API keys (comma has no meaning here — one var per caller)
API_KEY_MAIN_APP=
API_KEY_MOBILE=

# Agendash basic-auth (protects /admin/jobs)
AGENDASH_USER=admin
AGENDASH_PASSWORD=

PORT=3001
